# Lint SQL bez połączenia z hurtownią (krok 0 CI). Templater jinja, nie dbt: templater dbt
# kompiluje projekt, a dim_orders.sql odpytuje BigQuery już przy kompilacji (get_column_values).
[sqlfluff]
dialect = bigquery
templater = jinja
max_line_length = 120

[sqlfluff:indentation]
# Konwencja projektu: tabulatory. Bez tego LT02 zgłasza ~100 fałszywych naruszeń.
indent_unit = tab
tab_space_size = 4

[sqlfluff:templater:jinja]
# Atrapy ref/source/config/var/is_incremental/this wbudowane w sqlfluff.
apply_dbt_builtins = True
# Własne makra projektu (is_weekend, get_brand_name) renderują się naprawdę.
load_macros_from_path = macros
# Atrapy tego, czego builtins nie mają: dbt_utils i target (patrz ci/sqlfluff_libs/).
library_path = ci/sqlfluff_libs
