# Szablon połączenia z BigQuery.
# Skopiuj do profiles.yml (plik jest w .gitignore) albo do ~/.dbt/profiles.yml.
#
# method: service-account, nie oauth: OAuth loguje osobę i działa tylko na jednej maszynie, konto
# serwisowe to tożsamość projektu z uprawnieniami jawnie w IAM, działająca też w CI i kontenerze.
# To TU, a nie w dbt (group/access), rozstrzyga się, kto może budować modele: dbt robi w BigQuery
# dokładnie to, na co IAM pozwala temu kontu.
#
# Wymagane zmienne środowiskowe (dev - domyślny target):
#   export BIGQUERY_PROJECT="twoj-projekt-gcp"
#   export BIGQUERY_KEYFILE="/sciezka/do/klucza/service-account.json"  # POZA folderem repo
# Tylko przy --target prod (osobna tożsamość, patrz komentarz przy targecie prod):
#   export BIGQUERY_PROD_PROJECT="twoj-projekt-gcp-prod"
#   export BIGQUERY_PROD_KEYFILE="/sciezka/do/klucza/service-account-prod.json"
ecommerce_analytics: # musi pasować do `profile:` w dbt_project.yml
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      keyfile: "{{ env_var('BIGQUERY_KEYFILE') }}"
      project: "{{ env_var('BIGQUERY_PROJECT') }}"
      dataset: dbt_dev_project
      location: US
      priority: interactive
      # threads = ile jobów dbt wysyła JEDNOCZEŚNIE (limit klienta), nie moc obliczeniowa. BigQuery
      # on-demand przydziela sloty per job i liczy bajty, więc threads zmienia tylko czas ścienny,
      # nie koszt. Najszerszy poziom DAG-u to kilka modeli - 64 nigdy nie byłoby wykorzystane,
      # 8 wystarcza z zapasem. Realną wartość mierzy się: dbt build --threads N + run_results.json.
      threads: 8
      job_execution_timeout_seconds: 300
      job_retries: 1
      # Twardy limit kosztu zapytania. BigQuery liczy zeskanowane BAJTY, nie czas - timeout wyżej
      # nie zatrzyma zapytania, które w 20 s przeczyta kilka TB. Po przekroczeniu limitu zapytanie
      # pada bez opłaty. 10 GiB to wartość startowa dla datasetu demo; stroić po total_bytes_billed
      # w INFORMATION_SCHEMA.JOBS.
      maximum_bytes_billed: 10737418240   # 10 GiB

    # Prod ma WŁASNE zmienne, bez fallbacku na zmienne dev. Przy wspólnym koncie dev/prod izolacja
    # to tylko nazwa datasetu: przypadkowe --target prod albo wyciek klucza dev = zapis do prod,
    # a w logach audytowych jedno konto dla wszystkich. Laptop z samym kluczem dev nie połączy się
    # z prod (brakujący env_var), a SA dev może mieć w IAM zapis tylko do swoich datasetów. dbt
    # renderuje tylko wybrany target, więc brak zmiennych prod nie przeszkadza w pracy na dev.
    # Docelowo: prod w osobnym projekcie GCP, w CI Workload Identity Federation zamiast pliku
    # klucza, lokalnie oauth + impersonate_service_account (ślad per osoba).
    prod:
      type: bigquery
      method: service-account
      keyfile: "{{ env_var('BIGQUERY_PROD_KEYFILE') }}"
      project: "{{ env_var('BIGQUERY_PROD_PROJECT') }}"
      dataset: dbt_prod_project
      location: US
      priority: interactive
      threads: 8  # uzasadnienie przy targecie dev
      job_execution_timeout_seconds: 300
      job_retries: 1
      # Wyżej niż w dev (pełne rebuildy, --full-refresh), ale skończony - ma złapać błąd, np. zgubiony filtr partycji.
      maximum_bytes_billed: 107374182400  # 100 GiB
